#!/bin/bash
### assume bedtools are available ###
### assume samtools are available ###
### install python packages ###
sudo apt-get install r-base python python-setuptools libpython-dev
sudo easy_install pip
python -m pip install --upgrade --force pip #sometimes pip has bugs, force upgrade it
pip install -U virtualenv
pip install -U scipy
pip install -U tables
pip install -U six
pip install -U pandas
pip install -U pysam
pip install -U pybedtools
#NOTE: currently setuptools >=34 causes ImportError problem in easy_install, pytables. 
#please use 33.1.1: 
#pip install setuptools==33.1.1
### install R packages ###
mkdir -p $(Rscript -e 'cat(Sys.getenv("R_LIBS_USER"))')
#CRAN: optparse, rjson, RColorBrewer
R> install.packages("optparse")
R> install.packages("rjson")
R> install.packages("RColorBrewer")
#Bioconductor: GenomicRanges, ggbio, GenomeInfoDb
R> source("http://bioconductor.org/biocLite.R")
R> biocLite("GenomicRanges")
R> biocLite("ggbio")
R> biocLite("GenomeInfoDb")
#Bioconductor Recommended: rhdf5, BSgenome.Hsapiens.UCSC.hg19, BSgenome.Hsapiens.UCSC.hg38, Rsamtools, Biostrings
R> biocLite("rhdf5")
R> biocLite("BSgenome.Hsapiens.UCSC.hg19")
R> biocLite("BSgenome.Hsapiens.UCSC.hg38")
R> biocLite("Rsamtools")
R> biocLite("Biostrings")

