#!/bin/bash

#this script demo ZoomX somatic call analysis
#bam from 10X Chromium data of Chr10:90M-130M of Patient526
#tested on BioLinux v8 Virtual Machine on running on AWS
#hardware configuration: cpu=1,mem=2GB,disk=25GB
#set ZOOMXPATH to your downloaded or cloned package path
#change ref, controlPf, controlBam, casePf, caseBam, outputPf, controlExp, caseExp accordingly
#usage: somatic case|control|diff somatic.cfg.sh [$ZOOMXPATH]


if [[ -z $1 ]]; then
  echo -e "usage:       somatic4 stage $cfgfile"  
  echo -e "to auto generate command lines with this prompt, do following:"
  echo -e "export cfgfile=some/cfgfile"
  echo -e "e.g.:"        
  echo -e "somatic4 controlCov $cfgfile"
  echo -e "somatic4 control $cfgfile"  
  echo -e "somatic4 caseCov $cfgfile"  
  echo -e "somatic4 case $cfgfile"
  echo -e "somatic4 controlCisRef $cfgfile"  
  echo -e "somatic4 controlDistRef $cfgfile"  
  echo -e "somatic4 controlTransRef $cfgfile"  
  echo -e "somatic4 case $cfgfile"  
  echo -e "somatic4 caseCisRef $cfgfile"  
  echo -e "somatic4 caseDistRef $cfgfile"  
  echo -e "somatic4 caseTransRef $cfgfile"  
  echo -e "somatic4 distDiff $cfgfile"  
  echo -e "somatic4 cisDiff $cfgfile"  
  echo -e "somatic4 transDiff $cfgfile"  
  exit
fi

SomaticRunOp=$1
SomaticCfgFile=$2

echo -e "{"
echo -e "  'ZOOMXPATH': '$ZOOMXPATH',"
echo -e "  'Task': 'ZoomX Somatic Calling'," 
echo -e "  'Note': 'to run: change following options in the $SomaticCfgFile accordingly',"
echo -e "  'mydate': '$mydate',"
source $SomaticCfgFile
echo -e "  'ref': '$ref',"
echo -e "  'gap': '$gap',"
echo -e "  'grid': '$grid',"
echo -e "  'covGrid': '$covGrid',"
echo -e "  'outputPf': '$outputPf',"
echo -e "  'distSize': '$distSize',"
echo -e "  'distSize': '$cisSize',"
echo -e "  'runOption': '$runOption',"
echo -e "  'controlPf': '$controlPf',"
echo -e "  'controlBam': '$controlBam',"
echo -e "  'controlExp': $controlExp,"
echo -e "  'controlMax': $controlMax,"
echo -e "  'casePf': '$casePf',"
echo -e "  'caseBam': '$caseBam',"
echo -e "  'caseExp': $caseExp,"
echo -e "  'caseMax': $caseMax,"
echo -e "  'maxPlot': $maxPlot,"

#process control files
if [[ $SomaticRunOp == "control" || $SomaticRunOp == "controlCov" || $SomaticRunOp == "controlCisRef" || $SomaticRunOp == "controlDistRef" || $SomaticRunOp == "controlTransRef" ]]; then
  log=$outputPf/$controlBam.log
  bed=$outputPf/$controlBam.multiFragBar.bed.a0
  h5=$outputPf/$controlBam.multiFragBar.h5.a0
  trans=$outputPf/$controlBam.jct.bedpe.tra   #output of inter chromosome junctions
  distal=$outputPf/$controlBam.jct.bedpe.dis  #output of distal (>200 KB) junctions
  cis=$outputPf/$controlBam.jct.bedpe.cis     #output of intra  (>50 KB) junctions
  cfg=$outputPf/$controlBam.gridScan.cfg.json        #output of gridScan configuraiton
  echo -e "  'controlOption': {"
  echo -e "    'log': '$log', 'bed': '$bed', 'h5': '$h5', 'trans': '$trans', 'distal': '$distal', 'cis':'$cis', 'cfg':'$cfg' }"
  echo -e "  'controlCmd': {"
fi

if [[ $SomaticRunOp == "controlCov" ]]; then
  controlCovCMD="(time samtools bedcov $ref.bed.w100s100 $controlPf/$controlBam >$controlCovFile) 2>$log.controlCov.$mydate"
  echo $controlCovCMD | bash
  echo -e "    controlCovCMD': '$controlCovCMD',"
fi

if [[ $SomaticRunOp == "control" ]]; then
  parse10xCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m parse10x -c $controlCovFile -o $outputPf/$controlBam -l 2 $controlPf/$controlBam >$log.parse10x.$mydate 2>&1"        #run parse10x module
  echo $parse10xCMD | bash
  echo -e "    parse10xCMD': '$parse10xCMD',"
  gridScanCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m gridScan -n 3 $grid $bed $h5 $outputPf/$controlBam >$log.gridScan.$mydate 2>&1" #run gridScan module on Chr22 only (50 Mbp)
  echo $gridScanCMD | bash
  echo -e "    'gridScanCMD': '$gridScanCMD'," 
  cisJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$cisSize && \$5 - \$2<=$distSize) print}' $outputPf/$controlBam.jct.bedpe >$cis"
  echo $cisJctCMD  | bash
  echo -e "    'cisJctCMD':'$cisJctCMD'," 
  distJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$distSize) print}' $outputPf/$controlBam.jct.bedpe >$distal"
  echo $distJctCMD | bash
  echo -e "    'distJctCMD': '$distJctCMD',"
  transJctCMD="awk '{if(\$1 != \$4 && \$1 < \$4) print}' $outputPf/$controlBam.jct.bedpe >$trans"
  echo $transJctCMD | bash
  echo -e "    'transJctCMD': '$transJctMCD',"
  
  IMrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$controlBam.IM.bedpe >$outputPf/$controlBam.geq$cisSize.IM.bedpe"
  echo $IMrdpCMD   | bash
  echo -e "    'IMrdpCMD':'$IMrdpCMD',"
  
  FFrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$controlBam.FF.bedpe >$outputPf/$controlBam.geq$cisSize.FF.bedpe"
  echo $FFrdpCMD   | bash
  echo -e "    'FFrdpCMD':'$FFrdpCMD',"
  
  RRrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$controlBam.RR.bedpe >$outputPf/$controlBam.geq$cisSize.RR.bedpe"
  echo $RRrdpCMD   | bash
  echo -e "    'RRrdpCMD':'$RRrdpCMD',"
fi
  
if [[ $SomaticRunOp == "controlCisRef" ]]; then
  cisRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -m $controlMax -e $controlExp -f $controlExp -o $outputPf/$controlBam.cis.E$controlExp -i $outputPf/$controlBam.geq$cisSize.IM.bedpe -j $outputPf/$controlBam.geq$cisSize.FF.bedpe -k $outputPf/$controlBam.geq$cisSize.RR.bedpe $controlPf/$controlBam $cis $cfg >$log.refineBreak.cis.E$controlExp.$mydate 2>&1"
  echo $cisRefCMD | bash
  echo -e "    'cisRefCMD':'$cisRefCMD',"
fi
  
if [[ $SomaticRunOp == "controlDistRef" ]]; then
  distRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -m $controlMax -e $controlExp -f $controlExp -o $outputPf/$controlBam.dist.E$controlExp -i $outputPf/$controlBam.geq$cisSize.IM.bedpe -j $outputPf/$controlBam.geq$cisSize.FF.bedpe -k $outputPf/$controlBam.geq$cisSize.RR.bedpe $controlPf/$controlBam $distal $cfg >$log.refineBreak.dist.E$controlExp.$mydate 2>&1"
  echo $distRefCMD | bash
  echo -e "    'distRefCMD':'$distRefCMD',"
fi
  
if [[ $SomaticRunOp == "controlTransRef" ]]; then
  transRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -m $controlMax -e $controlExp -f $controlExp -o $outputPf/$controlBam.tra.E$controlExp -i $outputPf/$controlBam.geq$cisSize.IM.bedpe -j $outputPf/$controlBam.geq$cisSize.FF.bedpe -k $outputPf/$controlBam.geq$cisSize.RR.bedpe $controlPf/$controlBam $trans $cfg >$log.refineBreak.tra.E$controlExp.$mydate 2>&1"
  echo $transRefCMD | bash
  echo -e "    'transRefCMD':'$transRefCMD',"
fi

#process case files
if [[ $SomaticRunOp == "case" || $SomaticRunOp == "caseCov" || $SomaticRunOp == "caseCisRef" || $SomaticRunOp == "caseDistRef" || $SomaticRunOp == "caseTransRef" ]]; then
  log=$outputPf/$caseBam.log
  bed=$outputPf/$caseBam.multiFragBar.bed.a0
  h5=$outputPf/$caseBam.multiFragBar.h5.a0
  trans=$outputPf/$caseBam.jct.bedpe.tra   #output of inter chromosome junctions
  distal=$outputPf/$caseBam.jct.bedpe.dis  #output of distal (>200 KB) junctions
  cis=$outputPf/$caseBam.jct.bedpe.cis     #output of intra  (>50 KB) junctions
  cfg=$outputPf/$caseBam.gridScan.cfg.json        #output of gridScan configuraiton
  echo -e "  'caseOption': {"
  echo -e "    'log': '$log', 'bed': '$bed', 'h5': '$h5', 'trans': '$trans', 'distal': '$distal', 'cis':'$cis', 'cfg':'$cfg' }"
  echo -e "  'caseCmd': {"
fi

if [[ $SomaticRunOp == "caseCov" ]]; then
  caseCovCMD="(time samtools bedcov $ref.bed.w100s100 $casePf/$caseBam >$caseCovFile) 2>$log.caseCov.$mydate"
  echo $caseCovCMD | bash
  echo -e "    caseCovCMD': '$caseCovCMD',"
fi

if [[ $SomaticRunOp == "case" ]]; then
  parse10xCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m parse10x -c $caseCovFile -o $outputPf/$caseBam -l 2 $casePf/$caseBam >$log.parse10x.$mydate 2>&1"        #run parse10x module
  echo $parse10xCMD | bash
  echo -e "    parse10xCMD': '$parse10xCMD',"

  gridScanCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m gridScan -n 3 $grid $bed $h5 $outputPf/$caseBam >$log.gridScan.$mydate 2>&1" #run gridScan module on Chr22 only (50 Mbp)
  echo $gridScanCMD | bash
  echo -e "    'gridScanCMD': '$gridScanCMD'," 

  cisJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$cisSize && \$5 - \$2<=$distSize) print}' $outputPf/$caseBam.jct.bedpe >$cis"
  echo $cisJctCMD  | bash
  echo -e "    'cisJctCMD':'$cisJctCMD'," 

  distJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$distSize) print}' $outputPf/$caseBam.jct.bedpe >$distal"
  echo $distJctCMD | bash
  echo -e "    'distJctCMD': '$distJctCMD',"

  transJctCMD="awk '{if(\$1 != \$4 && \$1 < \$4) print}' $outputPf/$caseBam.jct.bedpe >$trans"
  echo $transJctCMD | bash
  echo -e "    'transJctCMD': '$transJctMCD',"
  
  IMrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$caseBam.IM.bedpe >$outputPf/$caseBam.geq$cisSize.IM.bedpe"
  echo $IMrdpCMD   | bash
  echo -e "    'IMrdpCMD':'$IMrdpCMD',"
  
  FFrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$caseBam.FF.bedpe >$outputPf/$caseBam.geq$cisSize.FF.bedpe"
  echo $FFrdpCMD   | bash
  echo -e "    'FFrdpCMD':'$FFrdpCMD',"
  
  RRrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$caseBam.RR.bedpe >$outputPf/$caseBam.geq$cisSize.RR.bedpe"
  echo $RRrdpCMD   | bash
  echo -e "    'RRrdpCMD':'$RRrdpCMD',"
fi
  
if [[ $SomaticRunOp == "caseCisRef" ]]; then
  cisRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -m $caseMax -e $caseExp -f $caseExp -o $outputPf/$caseBam.cis.E$caseExp -i $outputPf/$caseBam.geq$cisSize.IM.bedpe -j $outputPf/$caseBam.geq$cisSize.FF.bedpe -k $outputPf/$caseBam.geq$cisSize.RR.bedpe $casePf/$caseBam $cis $cfg >$log.refineBreak.cis.E$caseExp.$mydate 2>&1"
  echo $cisRefCMD | bash
  echo -e "    'cisRefCMD':'$cisRefCMD',"
fi
  
if [[ $SomaticRunOp == "caseDistRef" ]]; then
  distRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -m $caseMax -e $caseExp -f $caseExp -o $outputPf/$caseBam.dist.E$caseExp -i $outputPf/$caseBam.geq$cisSize.IM.bedpe -j $outputPf/$caseBam.geq$cisSize.FF.bedpe -k $outputPf/$caseBam.geq$cisSize.RR.bedpe $casePf/$caseBam $distal $cfg >$log.refineBreak.dist.E$caseExp.$mydate 2>&1"
  echo $distRefCMD | bash
  echo -e "    'distRefCMD':'$distRefCMD',"
fi
  
if [[ $SomaticRunOp == "caseTransRef" ]]; then
  transRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -m $caseMax -e $caseExp -f $caseExp -o $outputPf/$caseBam.tra.E$caseExp -i $outputPf/$caseBam.geq$cisSize.IM.bedpe -j $outputPf/$caseBam.geq$cisSize.FF.bedpe -k $outputPf/$caseBam.geq$cisSize.RR.bedpe $casePf/$caseBam $trans $cfg >$log.refineBreak.tra.E$caseExp.$mydate 2>&1"
  echo $transRefCMD | bash
  echo -e "    'transRefCMD':'$transRefCMD',"
fi

#do somatic differentiation
if [[ $SomaticRunOp == "cisDiff" ]]; then
  log="$outputPf/$caseBam.cis.E$caseExp\_$controlBam.cis.E$controlExp.somatic.log.diff"
  cisDiffCMD="bedtools pairtopair -is -type notboth -a $outputPf/$caseBam.cis.E$caseExp.refined -b $outputPf/$controlBam.cis.E$controlExp.refined >$outputPf/$caseBam.cis.E$caseExp\_$controlBam.cis.E$controlExp.somatic 2>$log"
  echo $cisDiffCMD | bash
  echo -e "    'cisDiffCMD':'$cisDiffCMD',"

  moleFile=$outputPf/$caseBam.cis.E$caseExp\_$controlBam.cis.E$controlExp.somatic
  maxSize=$(cat $moleFile | wc -l)
  maxSize=$(expr $(($maxPlot>$maxSize?$maxSize:$maxPlot)) - 1)
  for i in `seq 1 $maxSize`; do
    getMolCMD="$ZOOMXPATH/../scripts/getMolecule.sh $moleFile $outputPf/$caseBam $i $moleFile.Plot >>$log 2>&1"
    echo $getMolCMD | bash
    plotMolCMD="$ZOOMXPATH/../scripts/plotMolecule.R $isUCSC $moleFile.Plot_$i >>$log 2>&1" 
    echo $plotMolCMD | bash
  done
fi

if [[ $SomaticRunOp == "distDiff" ]]; then
  log="$outputPf/$caseBam.dist.E$caseExp\_$controlBam.dist.E$controlExp.somatic.log.diff"
  distDiffCMD="bedtools pairtopair -is -type notboth -a $outputPf/$caseBam.dist.E$caseExp.refined -b $outputPf/$controlBam.dist.E$controlExp.refined >$outputPf/$caseBam.dist.E$caseExp\_$controlBam.dist.E$controlExp.somatic 2>$log"
  echo $distDiffCMD | bash
  echo -e "    'distDiffCMD':'$distDiffCMD',"

  moleFile=$outputPf/$caseBam.dist.E$caseExp\_$controlBam.dist.E$controlExp.somatic
  maxSize=$(cat $moleFile | wc -l)
  maxSize=$(expr $(($maxPlot>$maxSize?$maxSize:$maxPlot)) - 1)
  for i in `seq 1 $maxSize`; do
    getMolCMD="$ZOOMXPATH/../scripts/getMolecule.sh $moleFile $outputPf/$caseBam $i $moleFile.Plot >>$log 2>&1"
    echo $getMolCMD | bash
    plotMolCMD="$ZOOMXPATH/../scripts/plotMolecule.R $isUCSC $moleFile.Plot_$i >>$log 2>&1" 
    echo $plotMolCMD | bash
  done
fi

if [[ $SomaticRunOp == "transDiff" ]]; then
  log="$outputPf/$caseBam.tra.E$caseExp\_$controlBam.tra.E$controlExp.somatic.log.diff"
  transDiffCMD="bedtools pairtopair -is -type notboth -a $outputPf/$caseBam.tra.E$caseExp.refined -b $outputPf/$controlBam.tra.E$controlExp.refined >$outputPf/$caseBam.tra.E$caseExp\_$controlBam.tra.E$controlExp.somatic 2>$log"
  echo $transDiffCMD | bash
  echo -e "    'transDiffCMD':'$transDiffCMD',"

  moleFile=$outputPf/$caseBam.tra.E$caseExp\_$controlBam.tra.E$controlExp.somatic
  maxSize=$(cat $moleFile | wc -l)
  maxSize=$(expr $(($maxPlot>$maxSize?$maxSize:$maxPlot)) - 1)
  for i in `seq 1 $maxSize`; do
    getMolCMD="$ZOOMXPATH/../scripts/getMolecule.sh $moleFile $outputPf/$caseBam $i $moleFile.Plot >>$log 2>&1"
    echo $getMolCMD | bash
    plotMolCMD="$ZOOMXPATH/../scripts/plotMolecule.R $isUCSC $moleFile.Plot_$i >>$log 2>&1" 
    echo $plotMolCMD | bash
  done
fi

 #here we iterate through following steps for each junction file, handling max maxPlot events
 #  to get plotMolecule.R to work will need R>3 and R packages optparse, rjson, ggbio, ggplot2, GenomicRanges, RColorBrewer
 #  the packages should be automatically installed at first run of plotMolecule.R
 #  if not, you can do it mannually

echo -e "  }"
