#!/bin/bash

#this script demo ZoomX somatic call analysis
#bam from 10X Chromium data of Chr10:90M-130M of Patient526
#tested on BioLinux v8 Virtual Machine on running on AWS
#hardware configuration: cpu=1,mem=2GB,disk=25GB
#set ZOOMXPATH to your downloaded or cloned package path
#change ref, controlPf, controlBam, casePf, caseBam, outputPf, controlExp, caseExp accordingly
#usage: somatic case|control|diff somatic.cfg.sh [$ZOOMXPATH]


if [[ -z $1 ]]; then
  echo -e "usage:"
  echo -e "somatic5 stage $cfgfile"  
  echo -e "to auto generate command lines with this prompt, do following:"
  echo -e "export cfgfile=some/cfgfile"
  echo -e "somatic5 controlCov $cfgfile"
  echo -e "somatic5 caseCov $cfgfile"  
  echo -e "somatic5 controlParse $cfgfile"  
  echo -e "somatic5 caseParse $cfgfile"
  echo -e "somatic5 controlScan $cfgfile"  
  echo -e "somatic5 caseScan $cfgfile"
  echo -e "somatic5 controlCisRef $cfgfile"  
  echo -e "somatic5 controlDistRef $cfgfile"  
  echo -e "somatic5 controlTransRef $cfgfile"  
  echo -e "somatic5 caseCisRef $cfgfile"  
  echo -e "somatic5 caseDistRef $cfgfile"  
  echo -e "somatic5 caseTransRef $cfgfile"  
  echo -e "somatic5 distDiff $cfgfile"  
  echo -e "somatic5 cisDiff $cfgfile"  
  echo -e "somatic5 transDiff $cfgfile"  
  echo -e "somatic5 distShare $cfgfile"  
  echo -e "somatic5 cisShare $cfgfile"  
  echo -e "somatic5 transShare $cfgfile"  
  echo -e "add dry to any stage to preview the auto-generated command" 
  exit
fi

testSubstring () { # if $1 is a substring of $2
  echo $2 | grep -E -o $1
}

SomaticRunOp=$1
SomaticCfgFile=$2
dryMode=$( testSubstring "dry" $SomaticRunOp )
source $SomaticCfgFile

echo -e "{"
echo -e "  'ZOOMXPATH': '$ZOOMXPATH',"
echo -e "  'Task': 'ZoomX Somatic Calling'," 
echo -e "  'Note': 'to run: change configurations in \$SomaticCfgFile and specify \$SomaticRunOp accordingly',"
echo -e "  'mydate': '$mydate',"
echo -e "  'SomaticRunOp': '$SomaticRunOp',"
echo -e "  'SomaticCfgFile': '$SomaticCfgFile',"
echo -e "  'dryMode': '$dryMode',"
echo -e "  'ref': '$ref',"
echo -e "  'gap': '$gap',"
echo -e "  'grid': '$grid',"
echo -e "  'covGrid': '$covGrid',"
echo -e "  'outputPf': '$outputPf',"
echo -e "  'distSize': $distSize,"
echo -e "  'cisSize': $cisSize,"
echo -e "  'controlPf': '$controlPf',"
echo -e "  'controlBam': '$controlBam',"
echo -e "  'controlExp': $controlExp,"
echo -e "  'controlMax': $controlMax,"
echo -e "  'casePf': '$casePf',"
echo -e "  'caseBam': '$caseBam',"
echo -e "  'caseExp': $caseExp,"
echo -e "  'caseMax': $caseMax,"
echo -e "  'maxPlot': $maxPlot,"

#process control files;
if [[ ! -z $( testSubstring "control" $SomaticRunOp ) ]]; then # define common control variables;
  log=$outputPf/$controlBam.log
  bed=$outputPf/$controlBam.multiFragBar.bed.a0
  h5=$outputPf/$controlBam.multiFragBar.h5.a0
  trans=$outputPf/$controlBam.jct.bedpe.tra   #output of inter chromosome junctions
  distal=$outputPf/$controlBam.jct.bedpe.dis  #output of distal (>200 KB) junctions
  cis=$outputPf/$controlBam.jct.bedpe.cis     #output of intra  (>50 KB) junctions
  cfg=$outputPf/$controlBam.gridScan.cfg.json        #output of gridScan configuraiton
  echo -e "  'controlOption': {"
  echo -e "    'log': '$log', 'bed': '$bed', 'h5': '$h5', 'trans': '$trans', 'distal': '$distal', 'cis':'$cis', 'cfg':'$cfg' },"
  echo -e "  'controlCmd': {"
fi

if [[ ! -z $( testSubstring "controlCov" $SomaticRunOp ) ]]; then
  if [[ $caseCovFile == "none" ]]; then
    controlCovCMD="Error: need to specify a controlCovFile other than none in $SomaticCfgFile!"
  else
    controlCovCMD="(time samtools bedcov $ref.bed.w100s100 $controlPf/$controlBam >$controlCovFile) 2>$log.$SomaticRunOp.$mydate"
  fi
  if [[ -z $dryMode ]]; then echo $controlCovCMD | bash; fi
  echo -e "    controlCovCMD': '$controlCovCMD',"
fi

if [[ ! -z $( testSubstring "controlParse" $SomaticRunOp ) ]]; then
  parse10xCMD="PYTHONPATH=$ZOOMXPATH  python -m parse10x -o $outputPf/$controlBam -l 2 $controlPf/$controlBam >$log.$SomaticRunOp.$mydate 2>&1"        #run parse10x module
  if [[ -z $dryMode ]]; then echo $parse10xCMD | bash; fi
  echo -e "    parse10xCMD': '$parse10xCMD',"
fi

if [[ ! -z $( testSubstring "controlScan" $SomaticRunOp ) ]]; then
  if [[ $controlCovFile != "none" && -e $controlCovFile ]]; then  #covFile is specified and generated
    filterCMD="$ZOOMXPATH/../scripts/filterMolecule.R $controlCovFile $bed >$log.$SomaticRunOp.$mydate 2>&1" # apply filtering
  else #covFile is not specified or generated (missing?)
    filterCMD="(cp $bed $bed.clean && touch $bed.clean.bed) >$log.$SomaticRunOp.$mydate 2>&1" #create dummy filter files
  fi
  if [[ -z $dryMode ]]; then echo $filterCMD | bash; fi
  echo -e "    filterCMD': '$filterCMD',"
  gridScanCMD="PYTHONPATH=$ZOOMXPATH  python -m gridScan -n 3 $grid $bed $h5 $outputPf/$controlBam >>$log.$SomaticRunOp.$mydate 2>&1" #run gridScan module on Chr22 only (50 Mbp)
  if [[ -z $dryMode ]]; then echo $gridScanCMD | bash; fi
  echo -e "    'gridScanCMD': '$gridScanCMD'," 
  cisJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$cisSize && \$5 - \$2<=$distSize) print}' $outputPf/$controlBam.jct.bedpe >$cis 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $cisJctCMD | bash; fi
  echo -e "    'cisJctCMD':'$cisJctCMD'," 
  distJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$distSize) print}' $outputPf/$controlBam.jct.bedpe >$distal 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $distJctCMD | bash; fi
  echo -e "    'distJctCMD': '$distJctCMD',"
  transJctCMD="awk '{if(\$1 != \$4 && \$1 < \$4) print}' $outputPf/$controlBam.jct.bedpe >$trans 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $transJctCMD | bash; fi
  echo -e "    'transJctCMD': '$transJctMCD',"
  IMrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$controlBam.IM.bedpe >$outputPf/$controlBam.geq$cisSize.IM.bedpe 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $IMrdpCMD | bash; fi
  echo -e "    'IMrdpCMD':'$IMrdpCMD',"
  FFrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$controlBam.FF.bedpe >$outputPf/$controlBam.geq$cisSize.FF.bedpe 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $FFrdpCMD | bash; fi
  echo -e "    'FFrdpCMD':'$FFrdpCMD',"
  RRrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$controlBam.RR.bedpe >$outputPf/$controlBam.geq$cisSize.RR.bedpe 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $RRrdpCMD | bash; fi
  echo -e "    'RRrdpCMD':'$RRrdpCMD',"
fi
  
if [[ ! -z $( testSubstring "controlCisRef" $SomaticRunOp ) ]]; then
  cisRefCMD="PYTHONPATH=$ZOOMXPATH  python -m refineBreak -n 8 -m $controlMax -e $controlExp -f $controlExp -o $outputPf/$controlBam.cis.E$controlExp -i $outputPf/$controlBam.geq$cisSize.IM.bedpe -j $outputPf/$controlBam.geq$cisSize.FF.bedpe -k $outputPf/$controlBam.geq$cisSize.RR.bedpe $controlPf/$controlBam $cis $cfg >$log.$SomaticRunOp.$mydate 2>&1"
  if [[ -z $dryMode ]]; then echo $cisRefCMD | bash; fi
  echo -e "    'cisRefCMD':'$cisRefCMD',"
fi
  
if [[ ! -z $( testSubstring "controlDistRef" $SomaticRunOp ) ]]; then
  distRefCMD="PYTHONPATH=$ZOOMXPATH  python -m refineBreak -n 8 -m $controlMax -e $controlExp -f $controlExp -o $outputPf/$controlBam.dist.E$controlExp -i $outputPf/$controlBam.geq$cisSize.IM.bedpe -j $outputPf/$controlBam.geq$cisSize.FF.bedpe -k $outputPf/$controlBam.geq$cisSize.RR.bedpe $controlPf/$controlBam $distal $cfg >$log.$SomaticRunOp.$mydate 2>&1"
  if [[ -z $dryMode ]]; then echo $distRefCMD | bash; fi
  echo -e "    'distRefCMD':'$distRefCMD',"
fi
  
if [[ ! -z $( testSubstring "controlTransRef" $SomaticRunOp ) ]]; then
  transRefCMD="PYTHONPATH=$ZOOMXPATH  python -m refineBreak -n 8 -m $controlMax -e $controlExp -f $controlExp -o $outputPf/$controlBam.tra.E$controlExp -i $outputPf/$controlBam.geq$cisSize.IM.bedpe -j $outputPf/$controlBam.geq$cisSize.FF.bedpe -k $outputPf/$controlBam.geq$cisSize.RR.bedpe $controlPf/$controlBam $trans $cfg >$log.$SomaticRunOp.$mydate 2>&1"
  if [[ -z $dryMode ]]; then echo $transRefCMD | bash; fi
  echo -e "    'transRefCMD':'$transRefCMD',"
fi

#process case files
if [[ ! -z $( testSubstring "case" $SomaticRunOp ) ]]; then # define common case variables;
  log=$outputPf/$caseBam.log
  bed=$outputPf/$caseBam.multiFragBar.bed.a0
  h5=$outputPf/$caseBam.multiFragBar.h5.a0
  trans=$outputPf/$caseBam.jct.bedpe.tra   #output of inter chromosome junctions
  distal=$outputPf/$caseBam.jct.bedpe.dis  #output of distal (>200 KB) junctions
  cis=$outputPf/$caseBam.jct.bedpe.cis     #output of intra  (>50 KB) junctions
  cfg=$outputPf/$caseBam.gridScan.cfg.json        #output of gridScan configuraiton
  echo -e "  'caseOption': {"
  echo -e "    'log': '$log', 'bed': '$bed', 'h5': '$h5', 'trans': '$trans', 'distal': '$distal', 'cis':'$cis', 'cfg':'$cfg' },"
  echo -e "  'caseCmd': {"
fi

if [[ ! -z $( testSubstring "caseCov" $SomaticRunOp ) ]]; then
  if [[ $caseCovFile == "none" ]]; then
    caseCovCMD="Error: need to specify a caseCovFile other than none in $SomaticCfgFile!"
  else
    caseCovCMD="(time samtools bedcov $ref.bed.w100s100 $casePf/$caseBam >$caseCovFile) 2>$log.$SomaticRunOp.$mydate"
  fi
  if [[ -z $dryMode ]]; then echo $caseCovCMD | bash; fi
  echo -e "    caseCovCMD': '$caseCovCMD',"
fi

if [[ ! -z $( testSubstring "caseParse" $SomaticRunOp ) ]]; then
  parse10xCMD="PYTHONPATH=$ZOOMXPATH  python -m parse10x -c $caseCovFile -o $outputPf/$caseBam -l 2 $casePf/$caseBam >$log.$SomaticRunOp.$mydate 2>&1"        #run parse10x module
  if [[ -z $dryMode ]]; then echo $parse10xCMD | bash; fi
  echo -e "    parse10xCMD': '$parse10xCMD',"
fi

if [[ ! -z $( testSubstring "caseScan" $SomaticRunOp ) ]]; then
  if [[ $caseCovFile != "none" && -e $caseCovFile ]]; then  #covFile is specified and generated
    filterCMD="$ZOOMXPATH/../scripts/filterMolecule.R $caseCovFile $bed >$log.$SomaticRunOp.$mydate 2>&1" # apply filtering
  else #covFile is not specified or generated (missing?)
    filterCMD="cp $bed $bed.clean && touch $bed.clean.bed >$log.$SomaticRunOp.$mydate 2>&1" #create dummy filter files
  fi
  if [[ -z $dryMode ]]; then echo $filterCMD | bash; fi
  echo -e "    filterCMD': '$filterCMD',"
  gridScanCMD="PYTHONPATH=$ZOOMXPATH  python -m gridScan -n 3 $grid $bed $h5 $outputPf/$caseBam >>$log.$SomaticRunOp.$mydate 2>&1" #run gridScan module on Chr22 only (50 Mbp)
  if [[ -z $dryMode ]]; then echo $gridScanCMD | bash; fi
  echo -e "    'gridScanCMD': '$gridScanCMD'," 

  cisJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$cisSize && \$5 - \$2<=$distSize) print}' $outputPf/$caseBam.jct.bedpe >$cis 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $cisJctCMD | bash; fi
  echo -e "    'cisJctCMD':'$cisJctCMD'," 

  distJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$distSize) print}' $outputPf/$caseBam.jct.bedpe >$distal 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $distJctCMD | bash; fi
  echo -e "    'distJctCMD': '$distJctCMD',"

  transJctCMD="awk '{if(\$1 != \$4 && \$1 < \$4) print}' $outputPf/$caseBam.jct.bedpe >$trans 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $transJctCMD | bash; fi
  echo -e "    'transJctCMD': '$transJctMCD',"
  
  IMrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$caseBam.IM.bedpe >$outputPf/$caseBam.geq$cisSize.IM.bedpe 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $IMrdpCMD | bash; fi
  echo -e "    'IMrdpCMD':'$IMrdpCMD',"
  
  FFrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$caseBam.FF.bedpe >$outputPf/$caseBam.geq$cisSize.FF.bedpe 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $FFrdpCMD | bash; fi
  echo -e "    'FFrdpCMD':'$FFrdpCMD',"
  
  RRrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$caseBam.RR.bedpe >$outputPf/$caseBam.geq$cisSize.RR.bedpe 2>>$log.$SomaticRunOp.$mydate"
  if [[ -z $dryMode ]]; then echo $RRrdpCMD | bash; fi
  echo -e "    'RRrdpCMD':'$RRrdpCMD',"
fi
  
if [[ ! -z $( testSubstring "caseCisRef" $SomaticRunOp ) ]]; then
  cisRefCMD="PYTHONPATH=$ZOOMXPATH  python -m refineBreak -n 8 -m $caseMax -e $caseExp -f $caseExp -o $outputPf/$caseBam.cis.E$caseExp -i $outputPf/$caseBam.geq$cisSize.IM.bedpe -j $outputPf/$caseBam.geq$cisSize.FF.bedpe -k $outputPf/$caseBam.geq$cisSize.RR.bedpe $casePf/$caseBam $cis $cfg >$log.$SomaticRunOp.$mydate 2>&1"
  if [[ -z $dryMode ]]; then echo $cisRefCMD | bash; fi
  echo -e "    'cisRefCMD':'$cisRefCMD',"
fi
  
if [[ ! -z $( testSubstring "caseDistRef" $SomaticRunOp ) ]]; then
  distRefCMD="PYTHONPATH=$ZOOMXPATH  python -m refineBreak -n 8 -m $caseMax -e $caseExp -f $caseExp -o $outputPf/$caseBam.dist.E$caseExp -i $outputPf/$caseBam.geq$cisSize.IM.bedpe -j $outputPf/$caseBam.geq$cisSize.FF.bedpe -k $outputPf/$caseBam.geq$cisSize.RR.bedpe $casePf/$caseBam $distal $cfg >$log.$SomaticRunOp.$mydate 2>&1"
  if [[ -z $dryMode ]]; then echo $distRefCMD | bash; fi
  echo -e "    'distRefCMD':'$distRefCMD',"
fi
  
if [[ ! -z $( testSubstring "caseTransRef" $SomaticRunOp ) ]]; then
  transRefCMD="PYTHONPATH=$ZOOMXPATH  python -m refineBreak -n 8 -m $caseMax -e $caseExp -f $caseExp -o $outputPf/$caseBam.tra.E$caseExp -i $outputPf/$caseBam.geq$cisSize.IM.bedpe -j $outputPf/$caseBam.geq$cisSize.FF.bedpe -k $outputPf/$caseBam.geq$cisSize.RR.bedpe $casePf/$caseBam $trans $cfg >$log.$SomaticRunOp.$mydate 2>&1"
  if [[ -z $dryMode ]]; then echo $transRefCMD | bash; fi
  echo -e "    'transRefCMD':'$transRefCMD',"
fi

if [[ ! -z $( testSubstring "case" $SomaticRunOp ) || ! -z $( testSubstring "control" $SomaticRunOp ) ]]; then
  echo -e "  }" #closing caseCmd or controlCmd
fi

#do somatic differentiation
if [[ ! -z $( testSubstring "cisDiff" $SomaticRunOp ) ]]; then
  moleFile=$( echo $outputPf/$caseBam.cis.E$caseExp"_"$controlBam.cis.E$controlExp.somatic )
  echo -e "    'moleFile':'$moleFile',"
  log="$moleFile.log.$SomaticRunOp.$mydate"
  cisDiffCMD="bedtools pairtopair -is -type notboth -a $outputPf/$caseBam.cis.E$caseExp.refined -b $outputPf/$controlBam.cis.E$controlExp.refined >$outputPf/$caseBam.cis.E$caseExp\_$controlBam.cis.E$controlExp.somatic 2>$log"
  if [[ -z $dryMode ]]; then echo $cisDiffCMD | bash; fi
  echo -e "  'cisDiffCMD':'$cisDiffCMD',"
fi

if [[ ! -z $( testSubstring "distDiff" $SomaticRunOp ) ]]; then
  moleFile=$( echo $outputPf/$caseBam.dist.E$caseExp"_"$controlBam.dist.E$controlExp.somatic )
  echo -e "  'moleFile':'$moleFile',"
  log="$moleFile.log.$SomaticRunOp.$mydate"
  distDiffCMD="bedtools pairtopair -is -type notboth -a $outputPf/$caseBam.dist.E$caseExp.refined -b $outputPf/$controlBam.dist.E$controlExp.refined >$outputPf/$caseBam.dist.E$caseExp\_$controlBam.dist.E$controlExp.somatic 2>$log"
  if [[ -z $dryMode ]]; then echo $distDiffCMD | bash; fi
  echo -e "  'distDiffCMD':'$distDiffCMD',"
fi

if [[ ! -z $( testSubstring "transDiff" $SomaticRunOp ) ]]; then
  moleFile=$( echo $outputPf/$caseBam.tra.E$caseExp"_"$controlBam.tra.E$controlExp.somatic )
  echo -e "  'moleFile':'$moleFile',"
  log="$moleFile.log.$SomaticRunOp.$mydate"
  transDiffCMD="bedtools pairtopair -is -type notboth -a $outputPf/$caseBam.tra.E$caseExp.refined -b $outputPf/$controlBam.tra.E$controlExp.refined >$outputPf/$caseBam.tra.E$caseExp\_$controlBam.tra.E$controlExp.somatic 2>$log"
  if [[ -z $dryMode ]]; then echo $transDiffCMD | bash; fi
  echo -e "  'transDiffCMD':'$transDiffCMD',"
fi

#do germline sharing
if [[ ! -z $( testSubstring "cisShare" $SomaticRunOp ) ]]; then
  moleFile=$( echo $outputPf/$caseBam.cis.E$caseExp"_"$controlBam.cis.E$controlExp.somatic )
  echo -e "  'moleFile':'$moleFile',"
  log="$moleFile.log.$SomaticRunOp.$mydate"
  cisShareCMD="bedtools pairtopair -is -type both -a $outputPf/$caseBam.cis.E$caseExp.refined -b $outputPf/$controlBam.cis.E$controlExp.refined >$outputPf/$caseBam.cis.E$caseExp\_$controlBam.cis.E$controlExp.germline 2>$log"
  if [[ -z $dryMode ]]; then echo $cisShareCMD | bash; fi
  echo -e "  'cisShareCMD':'$cisShareCMD',"
fi

if [[ ! -z $( testSubstring "distShare" $SomaticRunOp ) ]]; then
  moleFile=$( echo $outputPf/$caseBam.dist.E$caseExp"_"$controlBam.dist.E$controlExp.somatic )
  echo -e "  'moleFile':'$moleFile',"
  log="$moleFile.log.$SomaticRunOp.$mydate"
  distShareCMD="bedtools pairtopair -is -type both -a $outputPf/$caseBam.dist.E$caseExp.refined -b $outputPf/$controlBam.dist.E$controlExp.refined >$outputPf/$caseBam.dist.E$caseExp\_$controlBam.dist.E$controlExp.germline 2>$log"
  if [[ -z $dryMode ]]; then echo $distShareCMD | bash; fi
  echo -e "  'distShareCMD':'$distShareCMD',"
fi

if [[ ! -z $( testSubstring "transShare" $SomaticRunOp ) ]]; then
  moleFile=$( echo $outputPf/$caseBam.tra.E$caseExp"_"$controlBam.tra.E$controlExp.somatic )
  echo -e "  'moleFile':'$moleFile',"
  log="$moleFile.log.$SomaticRunOp.$mydate"
  transShareCMD="bedtools pairtopair -is -type both -a $outputPf/$caseBam.tra.E$caseExp.refined -b $outputPf/$controlBam.tra.E$controlExp.refined >$outputPf/$caseBam.tra.E$caseExp\_$controlBam.tra.E$controlExp.germline 2>$log"
  if [[ -z $dryMode ]]; then echo $transShareCMD | bash; fi
  echo -e "  'transShareCMD':'$transShareCMD',"
fi

#plotting of Diff or Share Molecules
if [[ ! -z $(testSubstring "Diff" $SomaticRunOp) || ! -z $(testSubstring "Share" $SomaticRunOp) ]]; then 
  echo -e "  'getAndPlotCMD':["
  if [[ -e $moleFile ]]; then
    log="$moleFile.log.$SomaticRunOp.$mydate"
    maxSize=$(cat $moleFile | wc -l)
    maxSize=$(expr $(($maxPlot>$maxSize?$maxSize:$maxPlot)) - 1)
    for i in `seq 1 $maxSize`; do
      getMolCMD="$ZOOMXPATH/../scripts/getMolecule.sh $moleFile $outputPf/$caseBam $i $moleFile.Plot >>$log 2>&1"
      if [[ -z $dryMode ]]; then echo $getMolCMD | bash; fi
      plotMolCMD="$ZOOMXPATH/../scripts/plotMolecule.R $isUCSC $moleFile.Plot_$i $outputPf/$caseBam.gridScan.cfg.json >>$log 2>&1" 
      if [[ -z $dryMode ]]; then echo $plotMolCMD | bash; fi
      echo -e "    [ '$getMolCMD', '$plotMolCMD' ],"
    done
  fi
  echo -e "  ]"
fi

 #here we iterate through following steps for each junction file, handling max maxPlot events
 #  to get plotMolecule.R to work will need R>3 and R packages optparse, rjson, ggbio, ggplot2, GenomicRanges, RColorBrewer
 #  the packages should be automatically installed at first run of plotMolecule.R
 #  if not, you can do it mannually

echo -e "}" #closing global
