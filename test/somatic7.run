#!/usr/bin/env bash
if [[ -z $1 ]]; then
  cfgfile="somatic7.cfg"
else
  cfgfile=$1
fi

echo "zoomx somatic example version 7"
echo "sourcing $cfgfile ..."
source $cfgfile
if [[ ! $? -eq 0 ]]; then exit; fi
logfile=$cfgfile.log.$mydate
echo "logfile: $logfile"
echo "---------------------------------------------------------------"
echo -n "essential zoomxRun stages overview:"
stages=(caseCov caseParse caseScan caseDistRef caseTransRef caseCisRef caseDistPlot caseTransPlot caseCisPlot)
echo ${stages[*]}
echo "---------------------------------------------------------------"

stages=(controlCov caseCov controlParse controlScan caseParse caseScan controlCisRef controlDistRef controlTransRef caseDistRef caseTransRef caseCisRef caseDistPlot caseTransPlot caseCisPlot)
for s in ${stages[*]}; do
  echo -n "$s:"
  cmd="zoomxRun $s $cfgfile >$cfgfile.$s.json.$mydate 2>$logfile"
  echo -n $cmd
  echo $cmd | bash
  if [[ ! $? -eq 0 ]]; then
    echo "[ERROR]"
    echo "Failed Stage Command:" $cmd
    exit
  fi
  echo "[OK]"
done

echo "---------------------------------------------------------------"
echo -n "extended zoomxRun stages overview:"
stages=(distDiffMix cisDiffMix transDiffMix distShare cisShare transShare)
#stages=(distDiffMix cisDiffMixt transDiffMix distDiffPure cisDiffPure transDiffPure distShare cisShare transShare)
echo ${stages[*]}
echo "---------------------------------------------------------------"
#echo "-----------------------------------------" &&
#echo "NOTE: it is OK to see Errors in extended stages above, resulting from bedtools complaining bed file cannot be opened.
#It is because the file is zero sized as a result of no junction found in previous steps" &&
#echo "-----------------------------------------" &&

for s in ${stages[*]}; do
  echo -n "$s:"
  cmd="zoomxRun $s $cfgfile >$cfgfile.$s.json.$mydate 2>$logfile"
  echo -n $cmd
  echo $cmd | bash
  if [[ ! $? -eq 0 ]]; then
    echo "[WARNING]"
    echo "Warning Stage Command:" $cmd
  else
    echo "[OK]"
  fi
done

echo "---------------------------------------------------------------"
echo "all done successfully"
