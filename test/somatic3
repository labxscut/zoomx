#!/bin/bash
if [ -z $3 ]; then
    ZOOMXPATH=$HOME/setup/zoomx/zoomx/;
else
    ZOOMXPATH=$3;
fi
#this script demo ZoomX somatic call analysis
#bam from 10X Chromium data of Chr10:90M-130M of Patient526
#tested on BioLinux v8 Virtual Machine on running on AWS
#hardware configuration: cpu=1,mem=2GB,disk=25GB
#set ZOOMXPATH to your downloaded or cloned package path
#change ref, controlPf, controlBam, casePf, caseBam, outputPf, controlExp, caseExp accordingly
#usage: somatic case|control|diff somatic.cfg.sh [$ZOOMXPATH]
 
SomaticCfgFile=$2
SomaticRunOp=$1
echo -e "{"
echo -e "  'ZOOMXPATH': '$ZOOMXPATH',"
echo -e "  'Task': 'ZoomX Somatic Calling'," 
echo -e "  'Note': 'torun: change ref, controlPf, controlBam, casePf, caseBam, outputPf, controlExp, caseExp accordingly',"
mydate=$(LC_ALL=en_US.utf8 date +%Y%b%d)
echo -e "  'mydate': '$mydate',"
source $SomaticCfgFile

#ref=$HG37 #prefix to grid file, actual fasta file not needed
echo -e "  'ref': '$ref',"
#gap=$ref.acen+gap+hc.bed
echo -e "  'gap': '$gap',"
#grid=$ref.bed.w10Ks5K
echo -e "  'grid': '$grid',"
#outputPf=../02_ZoomX
echo -e "  'outputPf': '$outputPf',"
#distSize=200000
echo -e "  'distSize': '$distSize',"
#cisSize=50000
echo -e "  'distSize': '$cisSize',"
#runOption=""
echo -e "  'runOption': '$runOption',"
#controlPf=../01_RawData
echo -e "  'controlPf': '$controlPf',"
#controlBam=P05378_7176_nt.wg12.bam
echo -e "  'controlBam': '$controlBam',"
#controlExp=10
echo -e "  'controlExp': $controlExp,"
#casePf=../01_RawData
echo -e "  'casePf': '$casePf',"
#caseBam=P05378_7175_mt.wg12.bam
echo -e "  'caseBam': '$caseBam',"
#caseExp=25
echo -e "  'caseExp': $caseExp,"

#process control files
if [ $SomaticRunOp == "control" ]; then
  log=$outputPf/$controlBam.log
  bed=$outputPf/$controlBam.multiFragBar.bed.a0
  h5=$outputPf/$controlBam.multiFragBar.h5.a0
  trans=$outputPf/$controlBam.jct.bedpe.tra   #output of inter chromosome junctions
  distal=$outputPf/$controlBam.jct.bedpe.dis  #output of distal (>200 KB) junctions
  cis=$outputPf/$controlBam.jct.bedpe.cis     #output of intra  (>50 KB) junctions
  cfg=$outputPf/$controlBam.gridScan.cfg.json        #output of gridScan configuraiton
  echo -e "  'controlOption': {"
  echo -e "    'log': '$log', 'bed': '$bed', 'h5': '$h5', 'trans': '$trans', 'distal': '$distal', 'cis':'$cis', 'cfg':'$cfg' }"
  echo -e "  'controlCmd': {"
  parse10xCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m parse10x -o $outputPf/$controlBam -l 2 $controlPf/$controlBam >$log.parse10x.$mydate 2>&1"        #run parse10x module
  echo $parse10xCMD | bash
  echo -e "    parse10xCMD': '$parse10xCMD',"
  gridScanCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m gridScan -n 3 $grid $bed $h5 $outputPf/$controlBam >$log.gridScan.$mydate 2>&1" #run gridScan module on Chr22 only (50 Mbp)
  echo $gridScanCMD | bash
  echo -e "    'gridScanCMD': '$gridScanCMD'," 
  cisJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$cisSize && \$5 - \$2<=$distSize) print}' $outputPf/$controlBam.jct.bedpe >$cis"
  echo $cisJctCMD  | bash
  echo -e "    'cisJctCMD':'$cisJctCMD'," 
  distJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$distSize) print}' $outputPf/$controlBam.jct.bedpe >$distal"
  echo $distJctCMD | bash
  echo -e "    'distJctCMD': '$distJctCMD',"
  transJctCMD="awk '{if(\$1 != \$4 && \$1 < \$4) print}' $outputPf/$controlBam.jct.bedpe >$trans"
  echo $transJctCMD | bash
  echo -e "    'transJctCMD': '$transJctMCD',"
  
  IMrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$controlBam.IM.bedpe >$outputPf/$controlBam.geq$cisSize.IM.bedpe"
  echo $IMrdpCMD   | bash
  echo -e "    'IMrdpCMD':'$IMrdpCMD',"
  
  FFrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$controlBam.FF.bedpe >$outputPf/$controlBam.geq$cisSize.FF.bedpe"
  echo $FFrdpCMD   | bash
  echo -e "    'FFrdpCMD':'$FFrdpCMD',"
  
  RRrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$controlBam.RR.bedpe >$outputPf/$controlBam.geq$cisSize.RR.bedpe"
  echo $RRrdpCMD   | bash
  echo -e "    'RRrdpCMD':'$RRrdpCMD',"
  
  cisRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -e $controlExp -o $outputPf/$controlBam.cis.E$controlExp -i $outputPf/$controlBam.geq$cisSize.IM.bedpe -j $outputPf/$controlBam.geq$cisSize.FF.bedpe -k $outputPf/$controlBam.geq$cisSize.RR.bedpe $controlPf/$controlBam $cis $cfg >$log.refineBreak.cis.E$controlExp.$mydate 2>&1"
  echo $cisRefCMD | bash
  echo -e "    'cisRefCMD':'$cisRefCMD',"
  
  distRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -e $controlExp -o $outputPf/$controlBam.dist.E$controlExp -i $outputPf/$controlBam.geq$cisSize.IM.bedpe -j $outputPf/$controlBam.geq$cisSize.FF.bedpe -k $outputPf/$controlBam.geq$cisSize.RR.bedpe $controlPf/$controlBam $distal $cfg >$log.refineBreak.dist.E$controlExp.$mydate 2>&1"
  echo $distRefCMD | bash
  echo -e "    'distRefCMD':'$distRefCMD',"
  
  transRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -e $controlExp -o $outputPf/$controlBam.tra.E$controlExp -i $outputPf/$controlBam.geq$cisSize.IM.bedpe -j $outputPf/$controlBam.geq$cisSize.FF.bedpe -k $outputPf/$controlBam.geq$cisSize.RR.bedpe $controlPf/$controlBam $trans $cfg >$log.refineBreak.tra.E$controlExp.$mydate 2>&1"
  echo $transRefCMD | bash
  echo -e "    'transRefCMD':'$transRefCMD',"
  
  echo -e "  }"
fi

#process case files
if [ $SomaticRunOp == "case" ]; then
  log=$outputPf/$caseBam.log
  bed=$outputPf/$caseBam.multiFragBar.bed.a0
  h5=$outputPf/$caseBam.multiFragBar.h5.a0
  trans=$outputPf/$caseBam.jct.bedpe.tra   #output of inter chromosome junctions
  distal=$outputPf/$caseBam.jct.bedpe.dis  #output of distal (>200 KB) junctions
  cis=$outputPf/$caseBam.jct.bedpe.cis     #output of intra  (>50 KB) junctions
  cfg=$outputPf/$caseBam.gridScan.cfg.json        #output of gridScan configuraiton
  echo -e "  'caseOption': {"
  echo -e "    'log': '$log', 'bed': '$bed', 'h5': '$h5', 'trans': '$trans', 'distal': '$distal', 'cis':'$cis', 'cfg':'$cfg' }"
  echo -e "  'caseCmd': {"

  parse10xCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m parse10x -o $outputPf/$caseBam -l 2 $casePf/$caseBam >$log.parse10x.$mydate 2>&1"        #run parse10x module
  echo $parse10xCMD | bash
  echo -e "    parse10xCMD': '$parse10xCMD',"

  gridScanCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m gridScan -n 3 $grid $bed $h5 $outputPf/$caseBam >$log.gridScan.$mydate 2>&1" #run gridScan module on Chr22 only (50 Mbp)
  echo $gridScanCMD | bash
  echo -e "    'gridScanCMD': '$gridScanCMD'," 

  cisJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$cisSize && \$5 - \$2<=$distSize) print}' $outputPf/$caseBam.jct.bedpe >$cis"
  echo $cisJctCMD  | bash
  echo -e "    'cisJctCMD':'$cisJctCMD'," 

  distJctCMD="awk '{if(\$1 == \$4 && \$5 - \$2>$distSize) print}' $outputPf/$caseBam.jct.bedpe >$distal"
  echo $distJctCMD | bash
  echo -e "    'distJctCMD': '$distJctCMD',"

  transJctCMD="awk '{if(\$1 != \$4 && \$1 < \$4) print}' $outputPf/$caseBam.jct.bedpe >$trans"
  echo $transJctCMD | bash
  echo -e "    'transJctCMD': '$transJctMCD',"
  
  IMrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$caseBam.IM.bedpe >$outputPf/$caseBam.geq$cisSize.IM.bedpe"
  echo $IMrdpCMD   | bash
  echo -e "    'IMrdpCMD':'$IMrdpCMD',"
  
  FFrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$caseBam.FF.bedpe >$outputPf/$caseBam.geq$cisSize.FF.bedpe"
  echo $FFrdpCMD   | bash
  echo -e "    'FFrdpCMD':'$FFrdpCMD',"
  
  RRrdpCMD="awk '{if( \$4 != \$1 || (\$5-\$2)>$cisSize || (\$5-\$2)<-$cisSize) print}' $outputPf/$caseBam.RR.bedpe >$outputPf/$caseBam.geq$cisSize.RR.bedpe"
  echo $RRrdpCMD   | bash
  echo -e "    'RRrdpCMD':'$RRrdpCMD',"
  
  cisRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -e $caseExp -o $outputPf/$caseBam.cis.E$caseExp -i $outputPf/$caseBam.geq$cisSize.IM.bedpe -j $outputPf/$caseBam.geq$cisSize.FF.bedpe -k $outputPf/$caseBam.geq$cisSize.RR.bedpe $casePf/$caseBam $cis $cfg >$log.refineBreak.cis.E$caseExp.$mydate 2>&1"
  echo $cisRefCMD | bash
  echo -e "    'cisRefCMD':'$cisRefCMD',"
  
  distRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -e $caseExp -o $outputPf/$caseBam.dist.E$caseExp -i $outputPf/$caseBam.geq$cisSize.IM.bedpe -j $outputPf/$caseBam.geq$cisSize.FF.bedpe -k $outputPf/$caseBam.geq$cisSize.RR.bedpe $casePf/$caseBam $distal $cfg >$log.refineBreak.dist.E$caseExp.$mydate 2>&1"
  echo $distRefCMD | bash
  echo -e "    'distRefCMD':'$distRefCMD',"
  
  transRefCMD="PYTHONPATH=$ZOOMXPATH $runOption python -m refineBreak -n 8 -e $caseExp -o $outputPf/$caseBam.tra.E$caseExp -i $outputPf/$caseBam.geq$cisSize.IM.bedpe -j $outputPf/$caseBam.geq$cisSize.FF.bedpe -k $outputPf/$caseBam.geq$cisSize.RR.bedpe $casePf/$caseBam $trans $cfg >$log.refineBreak.tra.E$caseExp.$mydate 2>&1"
  echo $transRefCMD | bash
  echo -e "    'transRefCMD':'$transRefCMD',"
  
  echo -e "  }"
fi

#do somatic differentiation
if [ $SomaticRunOp == "diff" ]; then
  distDiffCMD="bedtools pairtopair -type neither -a $outputPf/$caseBam.dis.E$caseExp.refined -b $outputPf/$controlBam.dis.E$controlExp.refined >$outputPf/$caseBam.dis.E$caseExp-$controlBam.dis.E$controlExp.somatic"
  echo $distDiffCMD | bash
  echo -e "    'distDiffCMD':'$distDiffCMD',"
  #here we iterate through following steps for each junction file, handling max 100 events
  #  to get plotMolecule.R to work will need R>3 and R packages optparse, rjson, ggbio, ggplot2, GenomicRanges, RColorBrewer
  #  the packages should be automatically installed at first run of plotMolecule.R
  #  if not, you can do it mannually
  moleFile=$outputPf/$caseBam.dis.E$caseExp-$controlBam.dis.E$controlExp.somatic
  maxSize=$(cat $moleFile | wc -l)
  maxSize=$(expr $((100>$maxSize?$maxSize:100)) - 1)
  for i in `seq 1 $maxSize`; do
    getMolCMD="$ZOOMPATH/../scripts/getMolecule.sh $moleFile $outputPf/$caseBam $i $moleFile.Plot"
    echo $getMolCMD | bash
    plotMolCMD="$ZOOMXPATH/../scripts/plotMolecule.R $isUCSC $moleFile.Plot-$i" 
    echo $plotMolCMD | bash
  done
fi
