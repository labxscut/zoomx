#!/bin/bash

if [ -z $1 ]; then
		ZOOMXPATH=$HOME/setup/zoomx/zoomx/;
else
		ZOOMXPATH=$1;
fi

echo -e "testing ZoomX at $ZOOMXPATH ..."

PYTHONPATH=$ZOOMXPATH python -m parse10x 2>parse10x.simple.log
PYTHONPATH=$ZOOMXPATH python -m gridScan 2>gridScan.simple.log
PYTHONPATH=$ZOOMXPATH python -m refineBreak 2>refineBreak.simple.log

echo "done"
