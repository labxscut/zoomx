#!/usr/bin/env bash
if [[ -z "$1" ]]; then
  echo "usage: zoomxStage cfgfile"
  echo "example: zoomxStage somatic10.cfg"
  echo "  execute zoomxRun by sequential stages according to provided configure file"
  echo "following variables in cfgfile are places to specify stages:"
  echo "  essentialStages:" 
  echo "    customer defined stages that oughut to have results"
  echo "    that could include steps to:"
  echo "      1. scan for sequencing coverage of genomes: caseCov (controlCov) "
  echo "      2. parse bam files: caseParse (controlParse) "
  echo "      3. do genome wide grid scan: caseScan (controlScan)"
  echo "      4. refine breakpoint for distal, trans and cis junctions: caseDistRef caseTransRef caseCisRef (controlCisRef controlDistRef controlTransRef) "
  echo "      5. plot molecule supports for distal, trans and cis junctions: [caseDistPlot caseTransPlot caseCisPlot]"
  echo "  extendedStages:"
  echo "    customer defined stages that may have results"
  echo "    they also may not have results simply because the previous steps' output are empty"
  echo "    in this case, it will produce a WARNING"
  echo "    that could include steps to:"
  echo "      1. differential distal, trans and cis junctions betwen tumor and normal: (distDiffMix cisDiffMix transDiffMix) "
  echo "      2. intersect distal, trans and cis junctions betwen tumor and normal: (distShare cisShare transShare)"
  echo "NOTE:"
  echo "  steps only required only in somatic call run are in parenthesis ()"
  echo "  steps only required only in germline call run are in square bracket []"
  echo "  in resurrecting a broken run, completed stages can be eliminated from the configure file"
  exit
else
  cfgfile=$1
fi

echo "zoomxStage and zoomxRun version 9"
echo "sourcing $cfgfile ..."
source $cfgfile
if [[ ! $? -eq 0 ]]; then 
  echo "configure file" $file "was not successfully sourced"
  exit; 
fi

echo "---------------------------------------------------------------"
echo "zoomxStage master settings:" 
if [ ! -d $outputPf ]; then
  echo "create output dir" $outputPf
  mkdir $outputPf
fi
if [ ! -w $outputPf ] ; then 
  echo 'cannot write to output dir' $outputPf; 
  exit
else
  echo "create subdirs:" $logDir $cfgDir $datDir $resDir $plotDir
  mkdir $logDir
  mkdir $cfgDir
  mkdir $datDir
  mkdir $resDir
  mkdir $plotDir
  zoomxStageLogFile="$logDir/$cfgfile.zoomxStage.$mydate.log"
  zoomxStageReadmeFile="$outputPf/$cfgfile.zoomxStage.$mydate.readme"
  zoomxStageReadme="The zoomxStage script are provided for easy manage of zoomxRun\n
  Input ($cfgfile):\n 
    \t a configure file in the format as specified in manual\n
  \n
  Ouput ($outputPf):\n
    \t $zoomxStageReadmeFile : this readme file. \n
    \t $logDir : keep logs of zoomxRun and zoomxStage \n
    \t $cfgDir : keep json formatted configures of zoomxRun \n
    \t $datDir : keep intermediatary results of zoomxRun, some may be useful to user \n
    \t $resDir : keep main results of zoomxRun, mostly useful to user \n
    \t $plotDir : keep plotting results of zoomxRun, also useful to user \n
    \t $tempDir : keep temporary files of zoomx, to be cleaned after run"
    
  echo "zoomxStageLogFile: $zoomxStageLogFile"
  echo ""
  echo -e "zoomxStageReadme: $zoomxStageReadme"
  echo ""
  echo -e $zoomxStageReadme >$zoomxStageReadmeFile
fi
echo "---------------------------------------------------------------"

echo "---------------------------------------------------------------"
echo -n "essential zoomxRun stages overview:"
echo ${essentialStages[*]}
echo "---------------------------------------------------------------"

for s in ${essentialStages[*]}; do
  echo -n "$s:"
  cmd="time zoomxRun $s $cfgfile >$cfgDir/$cfgfile.$s.$mydate.json 2>$zoomxStageLogFile"
  echo -n $cmd
  echo $cmd | bash
  if [[ ! $? -eq 0 ]]; then
    echo "[ERROR]"
    echo "Failed Stage Command:" $cmd
    exit
  fi
  echo "[OK]"
done

echo "---------------------------------------------------------------"
echo -n "extended zoomxRun stages overview:"
echo ${extendedStages[*]}
echo "---------------------------------------------------------------"

for s in ${extendedStages[*]}; do
  echo -n "$s:"
  cmd="time zoomxRun $s $cfgfile >$cfgDir/$cfgfile.$s.$mydate.json 2>$zoomxStageLogFile"
  echo -n $cmd
  echo $cmd | bash
  if [[ ! $? -eq 0 ]]; then
    echo "[WARNING]"
    echo "Warning Stage Command:" $cmd
  else
    echo "[OK]"
  fi
done

echo "---------------------------------------------------------------"
echo "all done successfully"
