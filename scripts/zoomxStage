#!/usr/bin/env bash
if [[ -z "$1" ]]; then
  echo "usage: zoomxStage cfgfile"
  echo "example: zoomxStage somatic9.cfg"
  echo "  execute zoomxRun by sequential stages according to provided configure file"
  exit
else
  cfgfile=$1
fi

echo "zoomxStage and zoomxRun version 9"
echo "sourcing $cfgfile ..."
source $cfgfile
if [[ ! $? -eq 0 ]]; then 
  echo "configure file" $file "was not successfully sourced"
  exit; 
fi

echo "---------------------------------------------------------------"
echo "zoomxStage master settings:" 
if [ ! -d $outputPf ]; then
  echo "create output dir" $outputPf
  mkdir $outputPf
fi
if [ ! -w $outputPf ] ; then 
  echo 'cannot write to output dir' $outputPf; 
  exit
else
  echo "create subdirs:" $logDir $cfgDir $datDir $resDir $plotDir
  mkdir $logDir
  mkdir $cfgDir
  mkdir $datDir
  mkdir $resDir
  mkdir $plotDir
  zoomxStageLogFile="$logDir/$cfgfile.zoomxStage.$mydate.log"
  zoomxStageReadmeFile="$outputPf/$cfgfile.zoomxStage.$mydate.readme"
  zoomxStageReadme="The zoomxStage script are provided for easy manage of zoomxRun\n
  Input ($cfgfile):\n 
    \t a configure file in the format as specified in manual\n
  \n
  Ouput ($outputPf):\n
    \t $zoomxStageReadmeFile : this readme file. \n
    \t $logDir : keep logs of zoomxRun and zoomxStage \n
    \t $cfgDir : keep json formatted configures of zoomxRun \n
    \t $datDir : keep intermediatary results of zoomxRun, some may be useful to user \n
    \t $resDir : keep main results of zoomxRun, mostly useful to user \n
    \t $plotDir : keep plotting results of zoomxRun, also useful to user \n"
    
  echo "zoomxStageLogFile: $zoomxStageLogFile"
  echo ""
  echo -e "zoomxStageReadme: $zoomxStageReadme"
  echo ""
  echo -e $zoomxStageReadme >$zoomxStageReadmeFile
fi
echo "---------------------------------------------------------------"

echo "---------------------------------------------------------------"
echo -n "essential zoomxRun stages overview:"
echo ${essentialStages[*]}
echo "---------------------------------------------------------------"
#essentialStages are customer defined stages that oughut to have results
#  that could include steps to:
#    scan for sequencing coverage of genomes: caseCov (controlCov) 
#    parse bam files: caseParse (controlParse) 
#    do genome wide grid scan: caseScan (controlScan)
#    refine breakpoint for distal, trans and cis junctions: caseDistRef caseTransRef caseCisRef (controlCisRef controlDistRef controlTransRef) 
#    plot molecule supports for distal, trans and cis junctions: [caseDistPlot caseTransPlot caseCisPlot]
#  (steps only required only in somatic call run are in parenthesis)
#  [steps only required only in germline call run are in square bracket]
#  in resurrecting a broken run, completed stages can be eliminated from the configure file

for s in ${essentialStages[*]}; do
  echo -n "$s:"
  cmd="zoomxRun $s $cfgfile >$cfgDir/$cfgfile.$s.$mydate.json 2>$zoomxStageLogFile"
  echo -n $cmd
  echo $cmd | bash
  if [[ ! $? -eq 0 ]]; then
    echo "[ERROR]"
    echo "Failed Stage Command:" $cmd
    exit
  fi
  echo "[OK]"
done

echo "---------------------------------------------------------------"
echo -n "extended zoomxRun stages overview:"
echo ${extendedStages[*]}
echo "---------------------------------------------------------------"
#extendedStages are customer defined stages that may have results
#  they also may not have results simply because the previous steps' output are empty
#  in this case, it will produce a WARNING
#  that could include steps to:
#    differential distal, trans and cis junctions betwen tumor and normal: (distDiffMix cisDiffMix transDiffMix) 
#    intersect distal, trans and cis junctions betwen tumor and normal: (distShare cisShare transShare)
#  (steps only required only in somatic call run are in parenthesis)
#  [steps only required only in germline call run are in square bracket]
#  in resurrecting a broken run, completed stages can be eliminated from the configure file

for s in ${extendedStages[*]}; do
  echo -n "$s:"
  cmd="zoomxRun $s $cfgfile >$cfgDir/$cfgfile.$s.$mydate.json 2>$zoomxStageLogFile"
  echo -n $cmd
  echo $cmd | bash
  if [[ ! $? -eq 0 ]]; then
    echo "[WARNING]"
    echo "Warning Stage Command:" $cmd
  else
    echo "[OK]"
  fi
done

echo "---------------------------------------------------------------"
echo "all done successfully"
