#!/usr/bin/env bash
if [[ -z $1 ]]; then
  cfgfile="somatic8.cfg"
else
  cfgfile=$1
fi

echo "zoomx somatic example version 8"
echo "sourcing $cfgfile ..."
source $cfgfile
if [[ ! $? -eq 0 ]]; then exit; fi
logfile=$cfgfile.log.$mydate
echo "logfile: $logfile"

if [[ $mode == "somatic" ]]; then
  essentialStages=(controlCov caseCov controlParse controlScan caseParse caseScan controlCisRef controlDistRef controlTransRef caseDistRef caseTransRef caseCisRef caseDistPlot caseTransPlot caseCisPlot)
  extendedStages=(distDiffMix cisDiffMix transDiffMix distShare cisShare transShare)
else
  essentialStages=(caseCov caseParse caseScan caseDistRef caseTransRef caseCisRef caseDistPlot caseTransPlot caseCisPlot)
  extendedStages=()
fi

echo "---------------------------------------------------------------"
echo -n "essential zoomxRun stages overview:"
echo ${essentialStages[*]}
echo "---------------------------------------------------------------"

for s in ${essentialStages[*]}; do
  echo -n "$s:"
  cmd="zoomxRun $s $cfgfile >$cfgfile.$s.json.$mydate 2>$logfile"
  echo -n $cmd
  echo $cmd | bash
  if [[ ! $? -eq 0 ]]; then
    echo "[ERROR]"
    echo "Failed Stage Command:" $cmd
    exit
  fi
  echo "[OK]"
done

echo "---------------------------------------------------------------"
echo -n "extended zoomxRun stages overview:"
echo ${extendedStages[*]}
echo "---------------------------------------------------------------"

#echo "-----------------------------------------" &&
#echo "NOTE: it is OK to see Errors in extended stages above, resulting from bedtools complaining bed file cannot be opened.
#It is because the file is zero sized as a result of no junction found in previous steps" &&
#echo "-----------------------------------------" &&

for s in ${extendedStages[*]}; do
  echo -n "$s:"
  cmd="zoomxRun $s $cfgfile >$cfgfile.$s.json.$mydate 2>$logfile"
  echo -n $cmd
  echo $cmd | bash
  if [[ ! $? -eq 0 ]]; then
    echo "[WARNING]"
    echo "Warning Stage Command:" $cmd
  else
    echo "[OK]"
  fi
done

echo "---------------------------------------------------------------"
echo "all done successfully"
